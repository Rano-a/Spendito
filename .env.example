# MongoDB Atlas (or any MongoDB) connection string. The app connects to a
# database named "budgeto" regardless of what's in the URI path.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app-name>

# Any long random string — used to sign session cookies. Generate one with:
#   openssl rand -hex 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
